# ─────────────────────────────────────────────────────────────
# AI Test Platform · staging 候选环境配置模板（Phase 26.1）
# 复制为 .env（或由部署脚本注入）后部署到 staging 候选机。
# 敏感项（JWT_SECRET / DATABASE_URL / REDIS_URL / LLM_API_KEY / Webhook）由部署环境注入，
# 本文件只含占位符，禁止提交真实值进 Git。
# 部署手册：docs/operations/deployment.md
# ─────────────────────────────────────────────────────────────

# ── 运行模式：staging（生产候选，禁止直连 production 业务） ──
PLATFORM_MODE=staging
PLATFORM_ENVIRONMENT=staging

# ── 存储后端（staging 使用 sqlite；可切 postgres 验证） ──
PLATFORM_STORAGE=sqlite
# staging 数据目录（独立于本机开发目录，避免污染）
PLATFORM_DATA_DIR=/srv/panqu/platform-data

# ── JWT 认证（部署时必填：openssl rand -base64 48） ──
JWT_SECRET=
# staging 可保留种子用户，但生产类模式禁止默认口令，凭据必须由运维显式设置
PLATFORM_SEED_USERS=true
PLATFORM_ALLOW_DEFAULT_CREDENTIALS=false

# ── PostgreSQL（切 postgres 时必填） ──
DATABASE_URL=

# ── 分布式限流（staging 属于生产类模式，必须配置） ──
REDIS_URL=

# ── 真实 LLM（可选；staging 试运行建议配置，否则走 Mock/离线确定性回退） ──
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FALLBACK_MODEL=

# ── 通知（可选；配置后 P0/Release/Worker/Health 事件可推送飞书） ──
FEISHU_WEBHOOK_URL=
FEISHU_MENTION=

# ── 版本溯源（CI 构建时注入） ──
PLATFORM_VERSION=4.2.0
PLATFORM_COMMIT=
PLATFORM_BUILD_TIME=

# ── API 服务 ──
PLATFORM_API_HOST=0.0.0.0
PLATFORM_API_PORT=8787
# Web Dashboard 静态目录
PLATFORM_WEB_DIR=web/dist
