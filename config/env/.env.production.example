# ─────────────────────────────────────────────────────────────
# AI Test Platform · production 配置模板（Phase 26.1）
# 本文件仅作模板；生产部署由运维平台注入真实密钥，禁止提交任何真实值。
# production 安全默认：JWT_SECRET 必须、默认口令禁止、Dangerous=DENY、Risky=APPROVAL。
# ─────────────────────────────────────────────────────────────

PLATFORM_MODE=production
PLATFORM_ENVIRONMENT=production

# ── 存储后端（production 建议 postgres；DATABASE_URL 必须由部署环境显式注入） ──
# 启动顺序：DB Connection → Migration → Ready；任一步失败，服务不监听端口并退出。
PLATFORM_STORAGE=postgres
DATABASE_URL=

# ── 分布式限流（production 必填；启动时 connect + PING，失败不监听端口） ──
REDIS_URL=

# ── JWT 认证（production 必填，缺失 preflight 将 BLOCK） ──
JWT_SECRET=
# production 必须关闭默认口令与自动种子
PLATFORM_SEED_USERS=false
PLATFORM_ALLOW_DEFAULT_CREDENTIALS=false

# ── 真实 LLM（production 必填，禁止 Mock） ──
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FALLBACK_MODEL=

# ── 通知（production 建议开启飞书告警） ──
FEISHU_WEBHOOK_URL=
FEISHU_MENTION=

# ── 版本溯源 ──
PLATFORM_VERSION=4.2.0
PLATFORM_COMMIT=
PLATFORM_BUILD_TIME=

# ── API 服务 ──
PLATFORM_API_HOST=0.0.0.0
PLATFORM_API_PORT=8787
PLATFORM_WEB_DIR=web/dist
