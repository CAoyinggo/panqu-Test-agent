# ──────────────────────────────────────────────────────
# test-flow 环境变量配置模板
# 复制为 .env 并填写实际值，或通过 CI/CD Variables 注入
# 优先级：环境变量 > environments.json > 默认值
# ──────────────────────────────────────────────────────

# ── 基础配置 ──
# 目标环境（test / preonline）
TESTFLOW_ENV=test
# 报告输出根目录（Docker 内默认 /app/output，本地默认 ./output）
TESTFLOW_OUTPUT_DIR=/app/output
# 素材库根目录（通过环境变量显式提供；容器可使用 /app/assets）
TESTFLOW_ASSETS_DIR=/app/assets
# session-cookies.json 路径（可选，默认使用 environments.json 中的配置）
TESTFLOW_SESSION_COOKIES_PATH=
# 轮询间隔毫秒（可选，默认 3000）
TESTFLOW_POLL_INTERVAL_MS=

# ── 登录态（必填，CI 环境注入） ──
# cookie_string（浏览器会话，从 session-cookies.json 复制）
TESTFLOW_COOKIE=
# project_id（环境对应的项目 ID）
TESTFLOW_PROJECT_ID=
# 账号名
TESTFLOW_ACCOUNT=

# ── 环境覆盖（可选，覆盖 environments.json） ──
# 环境的 base_url
TESTFLOW_BASE_URL=
# 提交接口路径
TESTFLOW_SUBMIT_URL=
# 状态查询接口路径
TESTFLOW_STATUS_URL=
# 详情查询接口路径
TESTFLOW_DETAIL_URL=
# 计费接口路径
TESTFLOW_BILLING_URL=
# CSRF token 页面路径
TESTFLOW_CSRF_PAGE=

# ── JSON 扩展配置（可选，覆盖任意配置项） ──
# 支持 JSON 格式，合并到 environments.json 之上
# 示例：TESTFLOW_EXTRA='{"poll_interval_ms":5000}'
TESTFLOW_EXTRA=

# ── 飞书通知（可选） ──
# 飞书 webhook 地址
TESTFLOW_FEISHU_WEBHOOK=
# 飞书 @ 手机号（逗号分隔）
TESTFLOW_FEISHU_MENTION=

# ── 发布部署（CI/CD Variables，本地不需要） ──
# 测试服务器 SSH 私钥（CI secret，禁止硬编码）
TESTFLOW_DEPLOY_SSH_KEY=
# 测试服务器地址
TESTFLOW_DEPLOY_HOST=
# SSH 用户名（默认 root）
TESTFLOW_DEPLOY_USER=
# 测试服务器 SSH host key（可选，避免 ssh-keyscan）
TESTFLOW_DEPLOY_HOST_KEY=

# ── 报告上传 OSS（可选，--upload-reports 时使用） ──
# OSS endpoint（如 oss-cn-hangzhou.aliyuncs.com）
TESTFLOW_OSS_ENDPOINT=
# OSS bucket 名称
TESTFLOW_OSS_BUCKET=
# OSS AccessKey ID
TESTFLOW_OSS_ACCESS_KEY_ID=
# OSS AccessKey Secret
TESTFLOW_OSS_ACCESS_KEY_SECRET=
# 报告公开访问 URL 前缀（如 https://reports.example.com/test-flow）
TESTFLOW_REPORT_BASE_URL=

# ── 预发布环境（可选，CI 多环境时使用） ──
TESTFLOW_COOKIE_PREONLINE=
TESTFLOW_PROJECT_ID_PREONLINE=
TESTFLOW_ACCOUNT_PREONLINE=
TESTFLOW_BASE_URL_PREONLINE=
TESTFLOW_SUBMIT_URL_PREONLINE=
TESTFLOW_STATUS_URL_PREONLINE=
TESTFLOW_DETAIL_URL_PREONLINE=
TESTFLOW_BILLING_URL_PREONLINE=
TESTFLOW_CSRF_PAGE_PREONLINE=

# ══════════════════════════════════════════════════════════════
# AI Test Platform 平台运行时配置（Phase 26.1）
# 复制为 .env 并填写实际值；敏感项（JWT_SECRET / DATABASE_URL / REDIS_URL / LLM_API_KEY / Webhook）
# 一律通过部署环境注入，禁止提交进 Git。
# 详细说明见 docs/operations/configuration.md 与 deployment.md
# ══════════════════════════════════════════════════════════════

# ── 平台运行模式（development / test / staging / production） ──
PLATFORM_MODE=development
# 兼容部署/版本标签；安全策略以 PLATFORM_MODE 优先
PLATFORM_ENVIRONMENT=development
# ── 存储后端：memory / json / sqlite / postgres ──
PLATFORM_STORAGE=sqlite
# ── 平台数据目录（sqlite/json 持久化位置；缺省 <TESTFLOW_OUTPUT_DIR>/platform） ──
PLATFORM_DATA_DIR=

# ── JWT 认证（必填；production 模式缺失将阻断 preflight） ──
# 生成：openssl rand -base64 48
JWT_SECRET=
# 是否种子默认用户（production 建议显式 create 用户后关闭）
PLATFORM_SEED_USERS=true
# 是否允许默认口令登录（production 必须 false）
PLATFORM_ALLOW_DEFAULT_CREDENTIALS=true

# ── PostgreSQL（PLATFORM_STORAGE=postgres 时必填；无默认回退） ──
# production/staging 禁止 postgres/postgres；连接或迁移失败将阻断 Server listen。
DATABASE_URL=

# ── 分布式限流（production/staging 必填；开发环境使用有界 TTL/LRU 内存实现） ──
REDIS_URL=

# ── 真实 LLM（可选；不配置则使用 Mock/离线确定性回退） ──
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 备用模型（主模型不可用时降级）
LLM_FALLBACK_MODEL=

# ── 通知（可选；配置后平台事件可推送） ──
# 飞书机器人 webhook（真实发送；禁止提交）
FEISHU_WEBHOOK_URL=
# 飞书 @ 手机号（逗号分隔）
FEISHU_MENTION=

# ── 版本溯源（CI 构建时注入；缺省用代码常量 4.2.0） ──
PLATFORM_VERSION=4.2.0
PLATFORM_COMMIT=
PLATFORM_BUILD_TIME=

# ── API 服务（serve 命令） ──
PLATFORM_API_HOST=127.0.0.1
PLATFORM_API_PORT=8787
# Web Dashboard 静态目录（缺省 web/dist）
PLATFORM_WEB_DIR=
