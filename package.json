{
  "name": "test-flow",
  "version": "3.0.0",
  "description": "盼趣AI 测试执行流程（多模块通用测试框架，TypeScript 重构版）",
  "type": "module",
  "main": "dist/bin/run-test.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/bin/run-test.js",
    "dev": "node dist/bin/run-test.js --watch --debug",
    "dev:ts": "tsc -p tsconfig.json --watch",
    "migrate": "node scripts/migrate-json-to-ts.ts",
    "test": "node dist/bin/run-test.js --task src/cases --ci",
    "test:unit": "node --test dist/**/*.test.js",
    "test:all": "npm run build && node scripts/verify-migration.mjs",
    "test:wan3": "node dist/bin/run-test.js --task src/cases/wan3",
    "test:user": "node dist/bin/run-test.js --task src/cases/user",
    "test:order": "node dist/bin/run-test.js --task src/cases/order",
    "test:regression": "npm run build && node dist/bin/run-test.js --task src/cases --ci",
    "docker:build": "docker build -t test-flow:latest .",
    "docker:run": "docker run --rm -v $(pwd)/output:/app/output -v $(pwd)/src/cases:/app/src/cases:ro --env-file .env test-flow:latest",
    "docker:test": "docker run --rm -v $(pwd)/output:/app/output --env-file .env test-flow:latest --task src/cases --ci --upload-reports"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "chokidar": "^3.6.0",
    "p-limit": "^7.3.1"
  }
}
