{
  "name": "test-flow",
  "version": "3.0.0",
  "description": "盼趣AI 测试执行流程（多模块通用测试框架，TypeScript 重构版）",
  "type": "module",
  "main": "dist/bin/run-test.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/bin/run-test.js",
    "dev": "node dist/bin/run-test.js --watch --debug",
    "dev:ts": "tsc -p tsconfig.json --watch",
    "migrate": "node scripts/migrate-json-to-ts.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node dist/bin/run-test.js --task src/cases --ci",
    "test:unit:old": "node --test dist/**/*.test.js",
    "test:all": "npm run build && node scripts/verify-migration.mjs",
    "test:wan3": "node dist/bin/run-test.js --task src/cases/wan3",
    "test:user": "node dist/bin/run-test.js --task src/cases/user",
    "test:order": "node dist/bin/run-test.js --task src/cases/order",
    "test:regression": "npm run build && node dist/bin/run-test.js --task src/cases --ci",
    "docker:build": "docker build -t test-flow:latest .",
    "docker:run": "docker run --rm -v $(pwd)/output:/app/output -v $(pwd)/src/cases:/app/src/cases:ro --env-file .env test-flow:latest",
    "docker:test": "docker run --rm -v $(pwd)/output:/app/output --env-file .env test-flow:latest --task src/cases --ci --upload-reports",
    "prepare": "husky",
    "security:audit": "bash scripts/security/audit.sh",
    "security:semgrep": "semgrep --config semgrep.yml --json --output security-reports/semgrep.json .",
    "security:gitleaks": "gitleaks detect --config .gitleaks.toml --report-format json --report-path security-reports/gitleaks.json --source .",
    "security:license": "bash scripts/security/license-check.sh",
    "security:local": "bash scripts/security/local-scan.sh",
    "security:full": "npm run security:audit && npm run security:semgrep && npm run security:gitleaks && npm run security:license",
    "deploy:smoke": "bash scripts/deploy/smoke-test-local.sh",
    "deploy:notify": "node scripts/deploy/notify-feishu.mjs",
    "ci:allure": "bash scripts/ci/generate-allure-html.sh",
    "ci:summary": "bash scripts/ci/github-summary.sh"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": "bash scripts/security/pre-commit-scan.sh"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "allure-commandline": "^2.30.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "chokidar": "^3.6.0",
    "p-limit": "^7.3.1"
  }
}
